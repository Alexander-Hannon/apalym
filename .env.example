# Shared
APP_ENV=dev

# Postgres
POSTGRES_DB=apalym
POSTGRES_USER=apalym
POSTGRES_PASSWORD=apalym_password
DATABASE_URL=postgresql://apalym:apalym_password@db:5432/apalym
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Redis
REDIS_URL=redis://redis:6379/0

# Ports
WEB_PORT=3000
API_PORT=8000
AI_PORT=8001



# ===== Gemini =====
GEMINI_API_KEY=your_gemini_api_key_here

# ===== Pinecone =====
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=aplaym-docs-768
# Optional (depends on client usage)
PINECONE_HOST=your_pinecone_host_here

