# Shared
APP_ENV=dev

# --- Client testing / tenant isolation (API) ---
# When set (non-empty), each entry is: access_key:tenant_id:Optional Display Label
# Separate multiple entries with semicolons. Example:
# APALYM_CLIENT_TEST_KEYS=sk_client_a:tenant-a:Client A;sk_client_b:tenant-b:Client B
# Leave unset or empty for open demo mode (single DEMO_TENANT_ID).
APALYM_CLIENT_TEST_KEYS=

# Shared tenant id when APALYM_CLIENT_TEST_KEYS is empty (internal demos only).
DEMO_TENANT_ID=demo-tenant

# Comma-separated browser origins allowed to call the API (CORS).
CORS_ALLOW_ORIGINS=http://localhost:3000

# Postgres
POSTGRES_DB=apalym
POSTGRES_USER=apalym
POSTGRES_PASSWORD=apalym_password
DATABASE_URL=postgresql://apalym:apalym_password@db:5432/apalym
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000


# Redis
REDIS_URL=redis://redis:6379/0

# Ports
WEB_PORT=3000
API_PORT=8000
AI_PORT=8001


GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_API_KEY={INSERT GEMINI API KEY}
PINECONE_API_KEY={INSERT PINECONE API KEY}
PINECONE_INDEX=aplaym-docs-768
PINECONE_HOST={INSERT HOST URL}


